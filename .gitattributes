# Lumen runs on Linux. CRLF in a shell script makes the kernel report
# "bad interpreter", and systemd will not parse a unit with CRLF line endings,
# so normalise everything to LF regardless of the platform it was authored on.
* text=auto eol=lf

*.sh     text eol=lf
*.py     text eol=lf
*.service text eol=lf
*.ini    text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
